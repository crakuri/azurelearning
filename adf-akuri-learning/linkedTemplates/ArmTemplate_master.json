{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-akuri-learning"
		},
		"FileServer1_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'FileServer1'"
		},
		"Local_Azure_FileSystem_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'Local_Azure_FileSystem'"
		},
		"adls_linked_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'adls_linked'"
		},
		"AzureDatabricks1_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "0918-153044-6vpvps82"
		},
		"AzureKeyVault1_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://chennalearningkeyvault.vault.azure.net/"
		},
		"FileServer1_properties_typeProperties_host": {
			"type": "string",
			"defaultValue": "E:\\Broswer_Downloads\\Motor+Vehicle+Thefts+CSV"
		},
		"FileServer1_properties_typeProperties_userId": {
			"type": "string",
			"defaultValue": "azure_adf"
		},
		"Local_Azure_FileSystem_properties_typeProperties_host": {
			"type": "string",
			"defaultValue": "E:\\Broswer_Downloads\\Azure_FileSystem"
		},
		"Local_Azure_FileSystem_properties_typeProperties_userId": {
			"type": "string",
			"defaultValue": "azure_adf"
		},
		"adls_linked_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://salearningakuri.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-akuri-learning_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"adls_linked_accountKey": {
						"value": "[parameters('adls_linked_accountKey')]"
					},
					"FileServer1_password": {
						"value": "[parameters('FileServer1_password')]"
					},
					"Local_Azure_FileSystem_password": {
						"value": "[parameters('Local_Azure_FileSystem_password')]"
					},
					"AzureDatabricks1_properties_typeProperties_existingClusterId": {
						"value": "[parameters('AzureDatabricks1_properties_typeProperties_existingClusterId')]"
					},
					"AzureKeyVault1_properties_typeProperties_baseUrl": {
						"value": "[parameters('AzureKeyVault1_properties_typeProperties_baseUrl')]"
					},
					"adls_linked_properties_typeProperties_url": {
						"value": "[parameters('adls_linked_properties_typeProperties_url')]"
					},
					"FileServer1_properties_typeProperties_host": {
						"value": "[parameters('FileServer1_properties_typeProperties_host')]"
					},
					"FileServer1_properties_typeProperties_userId": {
						"value": "[parameters('FileServer1_properties_typeProperties_userId')]"
					},
					"Local_Azure_FileSystem_properties_typeProperties_host": {
						"value": "[parameters('Local_Azure_FileSystem_properties_typeProperties_host')]"
					},
					"Local_Azure_FileSystem_properties_typeProperties_userId": {
						"value": "[parameters('Local_Azure_FileSystem_properties_typeProperties_userId')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "adf-akuri-learning_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adf-akuri-learning_ArmTemplate_0')]"
			]
		}
	]
}